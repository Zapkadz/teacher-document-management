generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  ADMIN
  USER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum WorkspaceType {
  PERSONAL
  SHARED
}

enum DocumentKind {
  FILE
  GOOGLE_DRIVE_LINK
  YOUTUBE_LINK
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String     @unique @db.VarChar(320)
  name          String?    @map("full_name") @db.VarChar(255)
  emailVerified DateTime?  @map("email_verified")
  image         String?    @map("avatar_url")
  globalRole    GlobalRole @default(USER) @map("global_role")
  status        UserStatus @default(PENDING)
  lastLoginAt   DateTime?  @map("last_login_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  accounts          Account[]
  sessions          Session[]
  personalWorkspace PersonalWorkspace?
  ownedFolders      Folder[]           @relation("FolderOwner")
  createdFolders    Folder[]           @relation("FolderCreator")
  deletedFolders    Folder[]           @relation("FolderDeleter")
  auditLogs         AuditLog[]         @relation("AuditActor")
  groupMemberships  GroupMember[]
  createdGroups     Group[]            @relation("GroupCreator")
  folderPermissions FolderPermission[] @relation("PermissionUser")
  permissionGrants  FolderPermission[] @relation("PermissionGranter")
  ownedDocuments    Document[]         @relation("DocumentOwner")
  deletedDocuments  Document[]         @relation("DocumentDeleter")
  documentVersions  DocumentVersion[]  @relation("VersionCreator")
  uploadSessions    UploadSession[]

  @@map("users")
}

model Account {
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model PersonalWorkspace {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId  String   @unique @map("owner_user_id") @db.Uuid
  rootFolderId String   @unique @map("root_folder_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  owner      User   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  rootFolder Folder @relation(fields: [rootFolderId], references: [id], onDelete: Restrict)

  @@map("personal_workspaces")
}

model Folder {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String        @db.VarChar(255)
  parentId           String?       @map("parent_id") @db.Uuid
  workspaceType      WorkspaceType @map("workspace_type")
  ownerUserId        String?       @map("owner_user_id") @db.Uuid
  inheritPermissions Boolean       @default(true) @map("inherit_permissions")
  isLocked           Boolean       @default(false) @map("is_locked")
  lockDescendants    Boolean       @default(false) @map("lock_descendants")
  sortOrder          Int           @default(0) @map("sort_order")
  createdBy          String        @map("created_by") @db.Uuid
  deletedAt          DateTime?     @map("deleted_at")
  deletedBy          String?       @map("deleted_by") @db.Uuid
  deletionBatchId    String?       @map("deletion_batch_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  parent            Folder?            @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children          Folder[]           @relation("FolderTree")
  owner             User?              @relation("FolderOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  creator           User               @relation("FolderCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  deleter           User?              @relation("FolderDeleter", fields: [deletedBy], references: [id], onDelete: Restrict)
  personalWorkspace PersonalWorkspace?
  permissions       FolderPermission[]
  documents         Document[]
  uploadSessions    UploadSession[]

  @@index([parentId, deletedAt])
  @@index([ownerUserId, workspaceType])
  @@index([deletionBatchId])
  @@map("folders")
}

model Group {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(255)
  description String?
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  creator     User               @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  members     GroupMember[]
  permissions FolderPermission[]

  @@map("groups")
}

model GroupMember {
  groupId   String   @map("group_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId, groupId])
  @@map("group_members")
}

model FolderPermission {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  folderId             String   @map("folder_id") @db.Uuid
  principalType        String   @map("principal_type") @db.VarChar(10)
  userId               String?  @map("user_id") @db.Uuid
  groupId              String?  @map("group_id") @db.Uuid
  permissions          Json     @default("[]")
  appliesToDescendants Boolean  @default(true) @map("applies_to_descendants")
  grantedBy            String   @map("granted_by") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  folder  Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user    User?   @relation("PermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  granter User    @relation("PermissionGranter", fields: [grantedBy], references: [id], onDelete: Restrict)

  @@index([folderId, principalType])
  @@index([userId, folderId])
  @@index([groupId, folderId])
  @@map("folder_permissions")
}

model Document {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  folderId         String         @map("folder_id") @db.Uuid
  ownerUserId      String         @map("owner_user_id") @db.Uuid
  title            String         @db.VarChar(255)
  description      String?
  documentKind     DocumentKind   @map("document_kind")
  originalFileName String?        @map("original_file_name") @db.VarChar(255)
  mimeType         String?        @map("mime_type") @db.VarChar(255)
  fileExtension    String?        @map("file_extension") @db.VarChar(20)
  sizeBytes        BigInt?        @map("size_bytes")
  storageKey       String?        @unique @map("storage_key")
  externalUrl      String?        @map("external_url")
  currentVersionId String?        @unique @map("current_version_id") @db.Uuid
  status           DocumentStatus @default(ACTIVE)
  deletedAt        DateTime?      @map("deleted_at")
  deletedBy        String?        @map("deleted_by") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  folder         Folder           @relation(fields: [folderId], references: [id], onDelete: Restrict)
  owner          User             @relation("DocumentOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  deleter        User?            @relation("DocumentDeleter", fields: [deletedBy], references: [id], onDelete: Restrict)
  currentVersion DocumentVersion? @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       DocumentVersion[] @relation("DocumentVersions")

  @@index([folderId, deletedAt, createdAt(sort: Desc)])
  @@index([ownerUserId, deletedAt])
  @@index([documentKind, deletedAt])
  @@map("documents")
}

model DocumentVersion {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId       String   @map("document_id") @db.Uuid
  versionNumber    Int      @map("version_number")
  originalFileName String?  @map("original_file_name") @db.VarChar(255)
  storageKey       String?  @unique @map("storage_key")
  externalUrl      String?  @map("external_url")
  mimeType         String?  @map("mime_type") @db.VarChar(255)
  sizeBytes        BigInt?  @map("size_bytes")
  changeNote       String?  @map("change_note")
  createdBy        String   @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  document  Document  @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  creator   User      @relation("VersionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  currentFor Document? @relation("CurrentDocumentVersion")

  @@unique([documentId, versionNumber])
  @@index([createdBy, createdAt(sort: Desc)])
  @@map("document_versions")
}

model UploadSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId       String    @unique @map("document_id") @db.Uuid
  versionId        String    @unique @map("version_id") @db.Uuid
  folderId         String    @map("folder_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  originalFileName String    @map("original_file_name") @db.VarChar(255)
  safeFileName     String    @map("safe_file_name") @db.VarChar(255)
  mimeType         String    @map("mime_type") @db.VarChar(255)
  fileExtension    String    @map("file_extension") @db.VarChar(20)
  sizeBytes        BigInt    @map("size_bytes")
  storageKey       String    @unique @map("storage_key")
  expiresAt        DateTime  @map("expires_at")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([folderId, completedAt])
  @@map("upload_sessions")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.Uuid
  folderId    String?  @map("folder_id") @db.Uuid
  metadata    Json     @default("{}")
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([folderId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
