# Application
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
AUTH_GOOGLE_ID=replace_with_google_oauth_client_id
AUTH_GOOGLE_SECRET=replace_with_google_oauth_client_secret

# Bootstrap admin used only by `npm run db:seed`
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_NAME=Quản trị viên
MAX_FOLDER_DEPTH=20
MAX_FILE_SIZE_MB=100
ALLOWED_FILE_EXTENSIONS=.doc,.docx,.xls,.xlsx,.pdf,.ppt,.pptx,.jpg,.jpeg,.png,.gif,.webp

# PostgreSQL (local development only)
POSTGRES_DB=teacher_documents
POSTGRES_USER=teacher_app
POSTGRES_PASSWORD=local_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://teacher_app:local_dev_password@localhost:5432/teacher_documents?schema=public

# MinIO / S3-compatible storage (local development only)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=local_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=local_minio_password
S3_BUCKET=teacher-documents
S3_FORCE_PATH_STYLE=true
